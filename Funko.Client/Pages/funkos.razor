@page "/funkos"
<h3>funkos</h3>
@inject HttpClient Http

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>📦 Catálogo de Funkos (GraphQL)</h3>
        <button class="btn btn-outline-primary btn-sm" @onclick="CargarFunkos">🔄 Recargar</button>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">Cargando productos desde el servidor...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div class="row">
            @if (funkos != null && funkos.Any())
            {
                @foreach (var funko in funkos)
                {
                    <div class="col-md-4 mb-3">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-primary">@funko.Name</h5>
                                <p class="card-text mb-1"><strong>Precio:</strong> @funko.Precio.ToString("C")</p>
                                <p class="card-text mb-1"><strong>Stock:</strong> @funko.Stock unidades</p>
                                @if (funko.Categoria != null)
                                {
                                    <span class="badge bg-secondary">@funko.Categoria.Name</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    <p>No se encontraron funkos en el sistema.</p>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Funko> funkos = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await CargarFunkos();
    }

    private async Task CargarFunkos()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            // La query GraphQL exacta contra tu backend
            var request = new
            {
                query = @"{
                    funkosPaged {
                        nodes {
                            id
                            name
                            precio
                            stock
                            categoria {
                                idY
                                name
                            }
                        }
                    }
                }"
            };

            var response = await Http.PostAsJsonAsync("graphql", request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<GraphQLResponseWrapper>();
                if (result?.Data?.FunkosPaged?.Nodes != null)
                {
                    funkos = result.Data.FunkosPaged.Nodes;
                }
            }
            else
            {
                errorMessage = $"Error al conectar con la API: {response.ReasonPhrase}";
            }
        }
        jmp catch (Exception ex)
        {
            errorMessage = $"Excepción: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    // Clases auxiliares para mapear el JSON de la respuesta de Hot Chocolate
    public class GraphQLResponseWrapper { public DataContent? Data { get; set; } }
    public class DataContent { public FunkosConnection? FunkosPaged { get; set; } }
    public class FunkosConnection { public List<FunkoDto>? Nodes { get; set; } }
    public class FunkoDto 
    { 
        long Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int Stock { get; set; }
        public CategoriaDto? Categoria { get; set; }
    }
    public class CategoriaDto
    {
        public string IdY { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }
}