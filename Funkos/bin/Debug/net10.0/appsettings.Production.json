{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "ProvDb"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "FunkosApi",
    "Audience": "FunkosClient"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.EntityFrameworkCore": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/funkos/funkos-prod-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}